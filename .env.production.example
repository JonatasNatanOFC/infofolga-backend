# Configuração de Produção — InfoFolga API
# IMPORTANTE: Copie este arquivo para .env.production, substitua placeholders por valores reais.
# Nunca versionne .env.production com valores reais de secrets.

# Porta da API (interna, atrás de nginx)
PORT=8080

# Banco de dados PostgreSQL
POSTGRES_DB=infofolga
POSTGRES_USER=infofolga
# CUIDADO: gerar senha forte com: openssl rand -base64 32
POSTGRES_PASSWORD=GERAR_COM_openssl_rand_-base64_32

# URL de conexão JDBC (postgres sempre em localhost:5432 no container)
SPRING_DATASOURCE_URL=jdbc:postgresql://banco:5432/infofolga
SPRING_DATASOURCE_USERNAME=infofolga
SPRING_DATASOURCE_PASSWORD=GERAR_COM_openssl_rand_-base64_32

# Schema management — em produção, SEMPRE "validate"
# Migrations devem ser aplicadas via script SQL manual antes de subir a aplicação
SPRING_JPA_HIBERNATE_DDL_AUTO=validate

# JWT Secret — CUIDADO: mínimo 32 bytes, gerar com: openssl rand -base64 32
JWT_SECRET=GERAR_COM_openssl_rand_-base64_32

# Bind address — SEMPRE 127.0.0.1 em produção (nginx faz proxy externamente)
API_BIND=127.0.0.1

# Spring profile
SPRING_PROFILES_ACTIVE=prod
